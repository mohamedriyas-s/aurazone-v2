# AuraZone V2 — Environment Variables Template
# Copy this to .env in each app that needs it

# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aurazone_v2"

# ─── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────
ACCESS_TOKEN_SECRET="your-access-token-secret-here"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-here"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# ─── AWS S3 ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="aurazone-v2"

# ─── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ─── SMTP (Email) ───────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@aurazone.com"

# ─── App URLs ───────────────────────────────────────────
API_URL="http://localhost:4000"
CUSTOMER_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── API App (apps/api) ─────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─── Push Notifications (Web Push) ──────────────────────
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
